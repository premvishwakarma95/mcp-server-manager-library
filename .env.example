# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=Dynamic MCP Platform

# Database
MONGO_URI=mongodb://localhost:27017/dynamic_mcp
MONGO_DEBUG=false

# Redis (optional - caching layer)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60

# Security
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
EXEC_RATE_LIMIT_MAX=60

# Admin authentication
# Comma-separated list of API keys allowed to call /api/v1/admin/*
ADMIN_API_KEYS=local-admin-key
ADMIN_AUTH_ENABLED=true

# Tool execution defaults
DEFAULT_TOOL_TIMEOUT_MS=15000
DEFAULT_TOOL_RETRIES=0
MAX_TOOL_TIMEOUT_MS=120000

# Logging
LOG_LEVEL=info
EXECUTION_LOG_BODY_BYTES=8192

# Swagger
SWAGGER_ENABLED=true
